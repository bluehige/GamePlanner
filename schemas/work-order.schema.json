{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bluehige/GamePlanner/schemas/work-order.schema.json",
  "title": "GamePlanner Work Order",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "work_order_id",
    "request_summary",
    "interpreted_goal",
    "source_of_truth",
    "in_scope",
    "out_of_scope",
    "acceptance_criteria",
    "affected_systems",
    "verification",
    "risk_tier",
    "rollback"
  ],
  "properties": {
    "work_order_id": {
      "type": "string",
      "pattern": "^WO-[0-9]{4}-[0-9]{4}$"
    },
    "request_summary": {
      "type": "string",
      "minLength": 1
    },
    "raw_request_ref": {
      "type": "string"
    },
    "interpreted_goal": {
      "type": "object",
      "required": [
        "player_outcome",
        "system_outcome"
      ],
      "properties": {
        "player_outcome": {
          "type": "string",
          "minLength": 1
        },
        "system_outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_of_truth": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_systems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high",
        "prototype"
      ]
    },
    "rollback": {
      "type": "object",
      "required": [
        "baseline_sha",
        "strategy"
      ],
      "properties": {
        "baseline_sha": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
